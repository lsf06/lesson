# ===== 第1周：VPS 云端平台（公网，自签证书 → 代码内 verify=False）=====
# 使用方法：把本文件复制成 .env，再填入真实凭据（.env 已被 .gitignore 忽略，不会提交）
VPS_BASE_URL=https://123.58.43.162:8443
VPS_USERNAME=your_username
VPS_PASSWORD=your_password
VPS_DEVICE_ID=group01_esp32s3eye
VPS_CHANNEL=sensor1
# 单次请求超时（秒）
VPS_TIMEOUT=6
# 1=异步转发（默认，保护 ESP32 端 3s HTTP 超时）0=同步（仅课堂演示阻塞对比）
VPS_ASYNC=1
# 平台限制 300 条/分钟，本地留 20 条余量
VPS_RATE_LIMIT=280
# 登录失败后多少秒内不再重试，避免 401 刷成请求风暴
VPS_LOGIN_BACKOFF=30

# ===== DeepSeek（留空则使用本地规则引擎）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com